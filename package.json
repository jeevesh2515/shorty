{
  "name": "shorts-autopilot",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "start": "node dist-server/index.js",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/workflow.test.ts",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx scripts/seed.ts",
    "seed:jellyfish": "tsx scripts/seed-jellyfish.ts",
    "api:smoke": "tsx scripts/smoke.ts",
    "pipeline:smoke": "tsx scripts/pipeline-smoke.ts",
    "docker:validate": "tsx scripts/docker-validate.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}
