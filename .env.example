# ============================================================
# Shorts Autopilot — Environment Configuration
# Copy this file to .env and fill in only what you want to use.
# Every blank entry falls back to a zero-cost local mode.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8787
APP_ORIGIN=http://localhost:5173
# Set a random secret in production: openssl rand -hex 32
API_TOKEN=
SHORTS_DB_PATH=./data/shorts-autopilot.sqlite
MEDIA_DIR=./data/media
MAX_BODY_BYTES=10000000

# ── LLM / Script Generation ──────────────────────────────────
# Choose one provider mode. Everything else falls back to the
# deterministic local script (costs $0, always available).
#
# Options:
#   local       — no API calls, zero cost (default)
#   groq        — FREE  — 14 400 req/day, Llama 70B quality
#   openrouter  — FREE  — free-tier models (Llama, Mistral)
#   nvidia      — FREE* — NVIDIA NIM free credits on signup
#   gemini      — $$    — Gemini Flash ($0.002/script)
#   openai      — $$    — GPT-4o-mini  ($0.01/script)

LLM_PROVIDER=local

# ─ Groq (FREE — https://console.groq.com) ────────────────────
# Best free models: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b,
#                  mixtral-8x7b-32768, llama3-groq-70b-8192-tool-use-preview
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─ OpenRouter (FREE tier — https://openrouter.ai) ─────────────
# Append ":free" to a model name to use the zero-cost tier.
# Best free models: meta-llama/llama-3.1-8b-instruct:free
#                  mistralai/mistral-7b-instruct:free
#                  google/gemma-2-9b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ─ NVIDIA NIM (FREE credits — https://build.nvidia.com) ───────
# Best models: meta/llama-3.1-70b-instruct
#              qwen/qwen2-7b-instruct
#              mistralai/mistral-large-2-instruct
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ─ Gemini (low cost) ─────────────────────────────────────────
# https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─ OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Budget circuit-breaker (applies to paid providers only)
MONTHLY_AI_BUDGET_USD=5

# ── Topic Discovery ───────────────────────────────────────────
# YouTube Data API v3 (free — 10 000 quota units/day)
# https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=

# ── Visuals ───────────────────────────────────────────────────
# Pexels API (free — 200 req/hour)
# https://www.pexels.com/api/
PEXELS_API_KEY=

# ── YouTube Publishing ────────────────────────────────────────
# OAuth2 credentials — use a refresh token, never a short-lived
# access token. Set up in Google Cloud Console → Credentials.
# You can also use the "Connect YouTube" button in the dashboard
# to complete the OAuth flow interactively.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_OAUTH_REDIRECT_URI=

# ── TTS / Voiceover ───────────────────────────────────────────
# Speaches exposes an OpenAI-compatible /v1/audio/speech endpoint.
# Self-host: https://github.com/speaches-ai/speaches  (FREE, Docker)
# Dograh: https://github.com/dograh-hq/dograh         (FREE, Docker)
SPEACHES_API_URL=
DOGRAH_API_URL=
DOGRAH_API_KEY=

# ── Scheduler ────────────────────────────────────────────────
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MS=3600000
DEFAULT_NICHE=Productivity
SEED_DEMO=false
AUTOMATION_PAUSED=false
AUTO_APPROVE=false
AUTO_PUBLISH=false

# ── Frontend build & Telemetry ──────────────────────────────
# Tells the Vite build which API URL to point to.
# In production, set this to your Railway/Fly.io API URL.
# VITE_API_URL=https://your-app.railway.app
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
