# Shorts Autopilot server configuration
PORT=8787
APP_ORIGIN=http://localhost:5173
API_TOKEN=
SHORTS_DB_PATH=./data/shorts-autopilot.sqlite
MEDIA_DIR=./data/media
MAX_BODY_BYTES=1000000

# Provider mode: local, openai, or gemini
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MONTHLY_AI_BUDGET_USD=5

# Discovery / visuals
YOUTUBE_API_KEY=
PEXELS_API_KEY=

# YouTube OAuth: use a refresh token, never a short-lived access token
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Media: Speaches exposes an OpenAI-compatible /v1/audio/speech endpoint.
# Dograh can sit in front of a configured speech provider, but its standalone
# raw-TTS HTTP endpoint is not stable/documented; set the compatible endpoint here.
DOGRAH_API_URL=
DOGRAH_API_KEY=
SPEACHES_API_URL=

# Optional scheduler
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MS=3600000
DEFAULT_NICHE=Productivity
SEED_DEMO=false

# Frontend: set this at build time to connect the UI to the API.
# VITE_API_URL=http://localhost:8787
